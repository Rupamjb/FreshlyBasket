{
  "name": "freshly-api",
  "version": "1.0.0",
  "description": "Backend API for Freshly e-commerce website",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --inspect server.js",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:dev": "tsc && node dist/index.js",
    "postinstall": "npm run build && mkdir -p dist/types",
    "seed:categories": "node data/categorySeeder.js",
    "seed:products": "node data/productSeeder.js",
    "seed:new-products": "npx ts-node src/utils/seedProducts.ts",
    "seed:additional1": "npx ts-node src/utils/additionalProducts.ts",
    "seed:additional2": "npx ts-node src/utils/additionalProducts2.ts",
    "seed:additional3": "npx ts-node src/utils/additionalProducts3.ts",
    "seed:master": "npx ts-node src/utils/masterSeeder.ts",
    "seed:all": "node data/categorySeeder.js && node data/productSeeder.js",
    "upload:mongodb": "npm run build && node src/utils/uploadToMongoDBAtlas.js",
    "export:json": "npm run build && node src/utils/generateProductsJSON.js",
    "seed:new": "npx ts-node src/utils/newProductSeeder.ts",
    "upload:new": "npm run build && node src/utils/uploadProductsToMongoDB.js",
    "verify:products": "node src/utils/verifyProductsInMongoDB.js",
    "check:db": "node src/utils/checkDatabase.js",
    "seed:extended": "node --loader ts-node/esm src/utils/extendedProductSeeder.ts"
  },
  "keywords": [
    "ecommerce",
    "api",
    "express",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.7.0",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^6.16.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "stripe": "^12.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^18.16.0",
    "@types/node-fetch": "^2.6.12",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.38.0",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
